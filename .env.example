# Copy to .env.local for local development, and add the same values in
# Vercel > Project > Settings > Environment Variables.
# Find them in Supabase > Project Settings > API (or Data API).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Without these two values the store runs in demo mode with sample products,
# and checkout and /admin are disabled.
